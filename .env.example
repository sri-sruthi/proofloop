# Copy values into your shell or secret manager. Never commit a real API key.
PROOFLOOP_API_KEY=<replace-with-a-local-or-secret-manager-value>
PROOFLOOP_HOST=127.0.0.1
PROOFLOOP_PORT=8080
PROOFLOOP_ALLOWED_ORIGIN=http://localhost:8000

# Local demo identity (metadata only; no invoice or PII payloads).
PROOFLOOP_SEED_DEMO=true
PROOFLOOP_DEMO_TENANT_ID=proofloop-demo
PROOFLOOP_DEMO_ENVIRONMENT=LOCAL
PROOFLOOP_DEMO_BOUNDARY_ID=proofloop-demo-local-invoices
PROOFLOOP_DEMO_AGENT_ID=invoice-agent

# Integrated invoice-agent provider. Local default is deterministic and offline.
PROOFLOOP_MODEL_PROVIDER=fake
PROOFLOOP_MODEL_VERSION=fake-model-v0
PROOFLOOP_MAX_MODEL_CALLS=2
PROOFLOOP_MAX_RETRIES=1
PROOFLOOP_MAX_OUTPUT_TOKENS=2000
PROOFLOOP_MODEL_TIMEOUT_SECONDS=30
PROOFLOOP_SEED_SAFE_CANARY=true
PROOFLOOP_AGENT_WORKFLOW_ID=integrated-invoice-workflow
PROOFLOOP_AGENT_EXECUTION_ID=invoice-runtime
PROOFLOOP_AGENT_TRACE_ID=invoice-agent-assurance
PROOFLOOP_RUNTIME_CONFIG_VERSION=invoice-runtime-v1

# Bedrock mode only. Supply approved deployment values; no credentials belong here.
# PROOFLOOP_MODEL_PROVIDER=bedrock
PROOFLOOP_BEDROCK_MODEL_ID=<approved-bedrock-model-or-inference-profile-id>
PROOFLOOP_BEDROCK_MODEL_ARN=<approved-least-privilege-model-or-profile-arn>
PROOFLOOP_BEDROCK_REGION=<approved-aws-region>

# Never enable this without explicit authorization for a real paid model request.
PROOFLOOP_ALLOW_REAL_MODEL_SMOKE=false

# Incident service levels.
PROOFLOOP_AMBER_SLA_HOURS=24
PROOFLOOP_RED_SLA_HOURS=1

# AWS only. Leave empty for in-memory local storage.
PROOFLOOP_EVIDENCE_TABLE_NAME=<set-by-sam-in-aws>
PROOFLOOP_LOG_LEVEL=INFO
